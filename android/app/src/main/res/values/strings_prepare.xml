    <string name="prepare_head_pending">Ready to prepare: %1$s</string>
    <string name="prepare_head_failed">Could not prepare %1$s</string>
    <string name="prepare_head_running">Preparing %1$s</string>
    <!-- %1$s: the update's version number -->
    <string name="prepare_card_update">Update %1$s</string>
    <!-- a test build's simulated engine; %1$s: the line above. \u0020: the two spaces stay (aapt2 joins runs of spaces) -->
