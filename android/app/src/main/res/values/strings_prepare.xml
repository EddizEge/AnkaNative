    <!-- %1$s: prepare_what_*, %4$s: the time it takes ("about 22-40 minutes"), %6$s, %7$s: folders -->
    <string name="prepare_ask_text">%1$s, %2$d DLC.\n\nThe app builds the game\'s pack and %3$,d shaders from your dump, once: %4$s in the background, best on the charger. You can pause any time.\n\nNeeds about 1.5 GB (%5$.1f GB free): working files in %6$s, the pack in the app\'s storage (%7$s).</string>
    <string name="prepare_cannot_start">Cannot start: %1$s</string>
