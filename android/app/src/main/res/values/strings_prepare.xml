    <string name="prepare_note_done_text">Open Anka Native and tap %1$s.</string>
    <string name="prepare_note_running">Preparing %1$s</string>
    <string name="prepare_note_waiting">Waiting: %1$s</string>
    <string name="prepare_note_pausing">Pausing: %1$s</string>
    <string name="prepare_note_failed">Could not prepare %1$s</string>
    <string name="prepare_note_paused">Paused: %1$s</string>
    <!-- PackService: the time left in short, first in the running notification's title, which a collapsed notification shows on one line with the step
         (Android 12+ shows no text under a title when the notification has a progress bar). Short so it is not cut on a phone's width: whole minutes, hours and
         minutes as Eta.text rounds them; %2$d (the minutes) is always 5-55 -->
    <string name="prepare_eta_short_less">&lt;1 min left</string>
    <plurals name="prepare_eta_short_minutes">
        <item quantity="one">%1$d min left</item>
        <item quantity="other">%1$d min left</item>
    </plurals>
    <plurals name="prepare_eta_short_hours">
        <item quantity="one">%1$d h left</item>
        <item quantity="other">%1$d h left</item>
    </plurals>
    <plurals name="prepare_eta_short_hours_minutes">
        <item quantity="one">%1$d h %2$d min left</item>
        <item quantity="other">%1$d h %2$d min left</item>
    </plurals>
    <!-- the running notification's title with the time left (%1$s: prepare_eta_short_*) and the game (%2$s); expanded, the title is prepare_note_running -->
    <string name="prepare_note_running_left">%1$s · Preparing %2$s</string>
    <!-- JobWatch: the job's process ended and Android did not let the app start it again from the background (or it did not start): %1$s: the game; the text,
         %1$s: the step where it stopped (Job.stepMsg). A tap opens the app, which resumes it -->
    <string name="prepare_note_stopped">Interrupted: %1$s</string>
    <string name="prepare_note_stopped_text">Prepare stopped (%1$s). Tap to go on.</string>
    <string name="prepare_note_step">Step %1$d of %2$d · %3$d%%</string>
    <!-- %1$s: the step (Job.stepMsg), %3$s: why it waits or stopped -->
    <string name="prepare_note_progress">%1$s · %2$d%%</string>
    <string name="prepare_note_progress_why">%1$s · %2$d%%\n%3$s</string>
    <!-- the running notification with the time left (Eta): %1$s: the step (Job.stepMsg), %2$s: prepare_eta_*. The notification's text; a collapsed
         notification with a progress bar shows none on Android 12+, only its title (prepare_note_running_left) and subText. _big: the expanded notification -->
    <string name="prepare_note_running_eta">%2$s · %1$s</string>
    <string name="prepare_note_running_eta_big">%1$s\n%2$s</string>

    <!-- PackService: why a step failed (PrepareErrors): English in job.json's error, with its code and arguments beside it, so the status line
         (prepare_status_failed) and the notification show it in the user's language; %1$s: prepare_step_*_in_sentence (the object of "stopped"), %2$d: how many times (2 or more), %3$.1f: the step's memory in GB, tap %4$s: the button's label -->
    <string name="prepare_error_step_killed">Android stopped %1$s %2$d times before it finished, most likely for memory (it needs up to %3$.1f GB). Close other apps, then tap %4$s</string>
    <!-- %1$s: the title ID, %2$s: the version number -->
    <string name="prepare_error_dump_changed">the dump changed: it is now %1$s %2$s</string>
    <!-- %1$s: the step's code (rewrite, split, shaders, pack: the tools' word, not translated), %3$s: the tool's last [RED] line (English, as the tool wrote it) -->
    <string name="prepare_error_tool_exit">%1$s stopped with code %2$d (log: %3$s)</string>
    <string name="prepare_error_tool_exit_red">%1$s stopped with code %2$d: %3$s (log: %4$s)</string>
    <string name="prepare_error_compare">cannot compare the dump\'s shaders with the app\'s list: %1$s</string>
    <!-- %2$s: the game's version, %3$s: a file name, then %4$s: the button's label -->
    <string name="prepare_error_shader_map">the dump\'s shaders are not the ones this app knows for %1$s (%2$s, %3$s differs). The dump may be incomplete or modified: dump the game again, then %4$s</string>

    <!-- DumpCheck: why a dump cannot be prepared (PrepareErrors; English in job.json's error, with its code beside it). Whole sentences: the status line takes
         them through prepare_status_failed_sentence -->
    <string name="prepare_dump_free_unknown">Cannot read the free space of %1$s.</string>
    <string name="prepare_dump_space">Preparing needs %1$.1f GB free beside the dump; %2$s has %3$.2f GB free.</string>
    <string name="prepare_dump_not_writable">Cannot make %1$s: the folder beside the dump is not writable.</string>
    <!-- PackService before the shaders step (PrepareErrors results_free_unknown, a whole sentence; results_space, a phrase): the translated shaders' results live in the
         app's own storage (the phone's internal storage). results_free_unknown's %1$s: that folder; results_space's %1$.1f: GB needed, %2$.2f: GB free, tap %3$s: the button's label -->
    <string name="prepare_results_free_unknown">Cannot read the free space of the app\'s storage (%1$s).</string>
    <string name="prepare_error_results_space">Translating the shaders needs %1$.1f GB free in the phone\'s internal storage; it has %2$.2f GB free. Free some space, then tap %3$s</string>
    <!-- Job.statusMsg: a failure the packer gave an error code (JobErrors); %1$s: a step (prepare_step_*_in_sentence), %2$s: the code's text (errors_*, whole
         sentences ending in a full stop), Tap %3$s: the button's label -->
    <string name="prepare_status_failed_coded">Stopped at %1$s. %2$s Tap %3$s to go on.</string>
    <!-- Job.statusMsg: a failure of Prepare's own that is a whole sentence (DumpCheck's prepare_dump_*, which end in a full stop); %1$s: a step
         (prepare_step_*_in_sentence), Tap %3$s: the button's label. The phrases (prepare_error_*) go into prepare_status_failed -->
    <string name="prepare_status_failed_sentence">Stopped at %1$s: %2$s Tap %3$s to go on.</string>
</resources>
