<?xml version="1.0" encoding="utf-8"?>
<!-- English (the source): the prepare area (Ondevice, Job, PackService, DumpCheck). docs/i18n.md: keys start with prepare_, one file per area, translations keep the English file's name -->
<resources>
    <string name="prepare_cannot_use">Cannot use %1$s: %2$s</string>

    <!-- Ondevice: a build without the packer (also shown by the home screen) -->
    <string name="prepare_unavailable">This version of Anka Native cannot prepare a game on the phone. Prepare it once on a computer (Linux or Mac), as the README\'s \"Install\" steps say (github.com/EddizEge/AnkaNative), copy the pack next to the dump as &lt;title ID&gt;-work/android-pack, then add the game again or pick that pack folder.</string>
    <!-- Ondevice.shadersText: what making a pack's shaders does; %3$s / %1$s: the time it takes ("about 20-35 minutes"). An update (%1$,d of the game's %2$,d shaders):
         _quick when only the dump's files that hold them are read (shader_split.py DM_SPLIT_DELTA, the profile has that time), _full when the dump's shaders are all read again -->
    <string name="prepare_shaders_update_quick">Updates the shaders from your dump: %1$,d of the %2$,d are new or changed in this app version; the others are kept as they are. Only the parts of your dump that hold the new ones are read: %3$s in all, in the background.</string>
    <string name="prepare_shaders_update_full">Updates the shaders from your dump: %1$,d of the %2$,d are new or changed in this app version; the others are kept as they are. The dump\'s shaders are read again first, which is most of the time: %3$s in all, in the background.</string>
    <string name="prepare_shaders_make">Makes the shaders from your dump (%1$s, in the background).</string>
    <string name="prepare_shaders_make_default">Makes the shaders from your dump (about 20-35 minutes, in the background).</string>
    <!-- Ondevice.prepareShadersMsg: the same as one sentence after the word Prepare (the home screen's shader dialog) -->
    <string name="prepare_shaders_update_quick_step">Prepare updates the shaders from your dump: %1$,d of the %2$,d are new or changed in this app version; the others are kept as they are. Only the parts of your dump that hold the new ones are read: %3$s in all, in the background.</string>
    <string name="prepare_shaders_update_full_step">Prepare updates the shaders from your dump: %1$,d of the %2$,d are new or changed in this app version; the others are kept as they are. The dump\'s shaders are read again first, which is most of the time: %3$s in all, in the background.</string>
    <string name="prepare_shaders_make_step">Prepare makes the shaders from your dump (%1$s, in the background).</string>
    <string name="prepare_shaders_make_step_default">Prepare makes the shaders from your dump (about 20-35 minutes, in the background).</string>
