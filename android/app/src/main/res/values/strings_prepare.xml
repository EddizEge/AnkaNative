    <string name="prepare_manage_title">Preparing %1$s</string>
    <string name="prepare_button_done">Done</string>
    <string name="prepare_forget_title">Forget this job?</string>
    <string name="prepare_forget_body">Deleted: nothing. The screen stops showing the job.\n\nKept: its files in %1$s, the pack, your dump and your saves. Picking the same dump again finds the job.\n\nThe split\'s kept progress (a copy in the app\'s own storage) and the translated shaders (up to about 1 GB, also in the app\'s own storage) are deleted when a job of another game starts; until then an unfinished job resumes from them.</string>
    <string name="prepare_button_forget">Forget</string>
    <string name="prepare_not_deleted_dump">Not deleted: %1$s holds or is inside your dump.</string>
    <string name="prepare_not_deleted_save">Not deleted: %1$s holds or is inside your save folder.</string>
    <!-- Delete working files: the question's paragraphs (what goes, what stays, what follows) -->
    <string name="prepare_deleted_work">Deleted:\n· the working files in %1$s (rewritten code, split shaders, the job\'s progress)\n· the split\'s kept progress and the translated shaders, in the app\'s own storage</string>
    <string name="prepare_deleted_work_pack_inside">Deleted:\n· the working files in %1$s, with the pack inside them (rewritten code, split shaders, the job\'s progress)\n· the split\'s kept progress and the translated shaders, in the app\'s own storage</string>
    <string name="prepare_deleted_work_and_pack">Deleted:\n· the working files in %1$s (rewritten code, split shaders, the job\'s progress)\n· the split\'s kept progress and the translated shaders, in the app\'s own storage\n· the prepared pack and its shader library in %2$s</string>
    <string name="prepare_kept">Kept: your dump (%1$s) and your saves. Saves are never deleted here.</string>
    <string name="prepare_kept_save">Kept: your dump (%1$s) and your saves (%2$s). Saves are never deleted here.</string>
    <string name="prepare_kept_pack">Kept: your dump (%1$s) and your saves, and the pack (%2$s). Saves are never deleted here.</string>
    <string name="prepare_kept_pack_save">Kept: your dump (%1$s) and your saves (%2$s), and the pack (%3$s). Saves are never deleted here.</string>
    <string name="prepare_deleted_pack_end">The game will not start until it is prepared again (about 30-45 minutes).</string>
    <string name="prepare_deleted_work_end">A new Prepare starts from the beginning.</string>
    <string name="prepare_delete_pack_title">Delete the prepared pack?</string>
    <string name="prepare_delete_work_title">Delete working files?</string>
    <string name="prepare_button_delete">Delete</string>
    <string name="prepare_deleting">Deleting…</string>
    <string name="prepare_deleted_toast">Deleted. Your dump and saves are untouched.</string>

    <!-- Job: the steps (Job.STEP_KEYS), and the same inside a sentence (PrepareErrors.stepInSentence): a noun phrase that follows a preposition ("Stopped at
         checking the dump: …") and is the object of a verb (prepare_error_step_killed: "Android stopped checking the dump …"), never its subject. Portuguese
         and Spanish: write it with its article where the sentences need one -->
    <string name="prepare_step_identify">Checking the dump</string>
    <string name="prepare_step_rewrite">Rewriting the game code</string>
    <string name="prepare_step_split">Finding the shaders</string>
    <string name="prepare_step_shaders">Translating shaders</string>
    <string name="prepare_step_pack">Finishing the pack</string>
    <string name="prepare_step_identify_in_sentence">checking the dump</string>
    <string name="prepare_step_rewrite_in_sentence">rewriting the game code</string>
    <string name="prepare_step_split_in_sentence">finding the shaders</string>
    <string name="prepare_step_shaders_in_sentence">translating shaders</string>
    <string name="prepare_step_pack_in_sentence">finishing the pack</string>
    <!-- Job.stepMsg: the shaders step's end, and a step with its count; %1$s: a step above -->
    <string name="prepare_stage_library">Writing the shader library</string>
    <string name="prepare_stage_check">Checking the shader library</string>
    <string name="prepare_step_shaders_progress">Translating shaders: %1$,d of %2$,d</string>
    <string name="prepare_step_progress">%1$s %2$,d / %3$,d</string>
    <string name="prepare_step_count">%1$s %2$,d</string>
    <!-- Job.statusMsg: the job's status line; %1$s: a step (prepare_step_*), %2$s in failed: why it failed (a prepare_error_* phrase, in the user's language
         when job.json has its code, else job.json's English error); Tap %3$s: the button's label -->
    <string name="prepare_status_done">Ready to play.</string>
    <string name="prepare_status_failed">Stopped at %1$s: %2$s. Tap %3$s to go on.</string>
    <string name="prepare_status_pending">Not started yet.</string>
    <string name="prepare_status_paused">Paused: %1$s. %2$s.</string>
    <!-- Job.statusMsg while a pause was asked for and the tool stops (seconds): %1$s the step's line, as in paused -->
    <string name="prepare_status_pausing">Pausing after the work in hand. %1$s.</string>
    <string name="prepare_status_running">%1$s (step %2$d of %3$d).</string>
    <!-- %1$s in paused, running and interrupted: the step's line as the card shows it (Job.stepMsg: "Translating shaders: 1,234 of 5,000"), not a noun phrase -->
    <string name="prepare_status_interrupted">Interrupted (%1$s). Tap %2$s to go on.</string>
    <!-- a state or reason this app version does not know, as job.json has it -->
    <string name="prepare_status_raw">%1$s</string>
    <!-- Job.statusMsg: the status line (%1$s, one of the prepare_status_* sentences) with the job's notice after it (%2$s, prepare_notice_*: why a step runs again) -->
    <string name="prepare_status_notice">%1$s %2$s</string>
    <!-- Job.noticeMsg: the split runs again because this app version's tables of the game's shaders changed (JobInputs) -->
    <string name="prepare_notice_inputs_changed">This app version knows more of the game\'s shaders, so they are found in your dump again first.</string>
    <!-- Job.noticeMsg: a quick (delta) split missed a shader the update needs, so the whole split runs (PackService) -->
    <string name="prepare_notice_split_full">The quick read of your dump missed a shader this update needs, so all of the dump\'s shaders are read now.</string>
    <!-- Job.reasonMsg: why a job is paused; tap %1$s: the button's label -->
    <string name="prepare_reason_user">by you</string>
    <string name="prepare_reason_battery">battery below 20 %: plug in the charger to go on</string>
    <string name="prepare_reason_thermal">the phone is too hot: it goes on when it has cooled</string>
    <string name="prepare_reason_game">a game is running: it goes on when the game ends</string>
    <string name="prepare_reason_timeout">Android\'s daily limit for background work: open the app and tap %1$s</string>
    <string name="prepare_reason_refused">Android did not let it start in the background: open the app and tap %1$s</string>
    <string name="prepare_reason_apk">the app was updated with other shader tools: the shaders are translated again</string>
    <string name="prepare_reason_none">stopped</string>
    <string name="prepare_cannot_make_folder">cannot make %1$s</string>

    <!-- PackService: the notification -->
    <string name="prepare_channel_name">Preparing a game</string>
    <string name="prepare_channel_description">Progress while the app prepares a game from your dump</string>
    <string name="prepare_note_none">Preparing a game</string>
