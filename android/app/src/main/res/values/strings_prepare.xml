    <string name="prepare_card_progress">%1$d %%\u0020\u0020·\u0020\u0020shaders %2$,d of %3$,d</string>
    <string name="prepare_button_pause">Pause</string>
    <string name="prepare_button_prepare_again">Prepare again</string>
    <string name="prepare_button_retry">Retry</string>
    <string name="prepare_button_start">Start</string>
    <string name="prepare_button_resume">Resume</string>
    <string name="prepare_game_ready_toast">%1$s is ready to play.</string>
    <string name="prepare_checking">Checking %1$s…</string>

    <!-- Ondevice: a picked dump -->
    <string name="prepare_resume_title">Resume preparing?</string>
    <!-- %1$s: the job's status line -->
    <string name="prepare_resume_body">%1$s\n\nIt goes on from where it stopped.</string>
    <!-- the Manage sheet's button (prepare_manage_delete_work shows it with …), also named inside a sentence -->
    <string name="prepare_label_delete_work">Delete working files</string>
    <!-- The Preparing card's ⋯ button, named inside other areas' sentences (Ondevice.manageLabel; its description is prepare_card_manage) -->
    <string name="prepare_label_manage">Manage</string>
    <string name="prepare_other_folder_job">An unfinished job for this dump writes to %1$s: %2$s\n\nResume it from the card, or delete its working files (⋯ › %3$s) before preparing into another folder.</string>
    <string name="prepare_busy">%1$s is being prepared now (%2$s). Pause it first, then try again.</string>
    <!-- %1$s: prepare_shaders_update -->
    <string name="prepare_redo_code_update">Rewrites the game code (a few minutes). %1$s</string>
    <string name="prepare_redo_both">Makes the game code and the shaders again from your dump (%1$s, in the background).</string>
    <string name="prepare_redo_code">Rewrites the game code from your dump (a few minutes, in the background). The shaders are kept.</string>
    <string name="prepare_redo_other_tools">The pack\'s game code was made by other tools than this app\'s.</string>
    <string name="prepare_pack_line">Pack: %1$s</string>
    <string name="prepare_redo_title_code">Update the pack?</string>
    <string name="prepare_redo_title_shaders">Prepare shaders?</string>
    <string name="prepare_button_prepare">Prepare</string>
    <string name="prepare_pick_other_pack">Pick another pack folder</string>
    <!-- Prepare's question: the dump's version; %1$s: the update's version number, %2$s / %1$s: a build of the game in words -->
    <string name="prepare_what_base">Base game</string>
    <string name="prepare_what_update">Update %1$s</string>
    <string name="prepare_what_base_code">Base game (the code of %1$s)</string>
    <string name="prepare_what_update_code">Update %1$s (the code of %2$s)</string>
    <!-- %1$s: prepare_what_*, %4$s: the time it takes ("about 22-40 minutes"), %6$s, %7$s: folders -->
    <string name="prepare_ask_text">%1$s, %2$d DLC.\n\nThe app builds the game\'s pack and %3$,d shaders from your dump, once: %4$s in the background, best on the charger. You can pause any time.\n\nNeeds about 1.5 GB (%5$.1f GB free): working files in %6$s, the pack in the app\'s storage (%7$s).</string>
    <string name="prepare_cannot_start">Cannot start: %1$s</string>
    <string name="prepare_ask_elsewhere">Have a pack made elsewhere (on a computer, or exported from another phone)?</string>
    <string name="prepare_use_existing">Use an existing pack…</string>
    <string name="prepare_import">Import pack…</string>
    <string name="prepare_ask_title">Prepare %1$s?</string>
    <string name="prepare_ready_title">Ready to play</string>
    <string name="prepare_ready_body">Its pack fits: nothing needs preparing.\n\nPack: %1$s</string>
    <!-- %1$s: prepare_button_play -->
    <string name="prepare_simulated_pack">This pack was made by the simulated engine: it is a placeholder, so the game is not started. %1$s is enabled because the pack and its library are complete.</string>

    <!-- Ondevice: the job's Manage sheet (⋯) -->
    <string name="prepare_manage_info">%1$s\n\nDump: %2$s\nWorking files: %3$s\nPack: %4$s\nLogs: %5$s</string>
    <string name="prepare_manage_running">Pause first to forget or delete.</string>
    <string name="prepare_manage_forget">Forget this job…</string>
    <!-- %1$s: prepare_label_delete_work, the button's label -->
    <string name="prepare_manage_delete_work" translatable="false">%1$s…</string>
    <string name="prepare_manage_delete_pack">Delete the prepared pack too…</string>
    <string name="prepare_manage_title">Preparing %1$s</string>
    <string name="prepare_button_done">Done</string>
    <string name="prepare_forget_title">Forget this job?</string>
    <string name="prepare_forget_body">Deleted: nothing. The screen stops showing the job.\n\nKept: its files in %1$s, the pack, your dump and your saves. Picking the same dump again finds the job.\n\nThe split\'s kept progress (a copy in the app\'s own storage) is deleted when a job of another game starts; until then an unfinished split resumes from it.</string>
    <string name="prepare_button_forget">Forget</string>
    <string name="prepare_not_deleted_dump">Not deleted: %1$s holds or is inside your dump.</string>
    <string name="prepare_not_deleted_save">Not deleted: %1$s holds or is inside your save folder.</string>
    <!-- Delete working files: the question's paragraphs (what goes, what stays, what follows) -->
    <string name="prepare_deleted_work">Deleted:\n· the working files in %1$s (rewritten code, split and translated shaders, the job\'s progress)\n· the split\'s kept progress, a copy in the app\'s own storage</string>
    <string name="prepare_deleted_work_pack_inside">Deleted:\n· the working files in %1$s (rewritten code, split and translated shaders, the job\'s progress)\n· the split\'s kept progress, a copy in the app\'s own storage with the pack inside it</string>
    <string name="prepare_deleted_work_and_pack">Deleted:\n· the working files in %1$s (rewritten code, split and translated shaders, the job\'s progress)\n· the split\'s kept progress, a copy in the app\'s own storage\n· the prepared pack and its shader library in %2$s</string>
    <string name="prepare_kept">Kept: your dump (%1$s) and your saves. Saves are never deleted here.</string>
    <string name="prepare_kept_save">Kept: your dump (%1$s) and your saves (%2$s). Saves are never deleted here.</string>
    <string name="prepare_kept_pack">Kept: your dump (%1$s) and your saves, and the pack (%2$s). Saves are never deleted here.</string>
    <string name="prepare_kept_pack_save">Kept: your dump (%1$s) and your saves (%2$s), and the pack (%3$s). Saves are never deleted here.</string>
    <string name="prepare_deleted_pack_end">The game will not start until it is prepared again (about 30-45 minutes).</string>
    <string name="prepare_deleted_work_end">A new Prepare starts from the beginning.</string>
    <string name="prepare_delete_pack_title">Delete the prepared pack?</string>
    <string name="prepare_delete_work_title">Delete working files?</string>
    <string name="prepare_button_delete">Delete</string>
    <string name="prepare_deleting">Deleting…</string>
    <string name="prepare_deleted_toast">Deleted. Your dump and saves are untouched.</string>

    <!-- Job: the steps (Job.STEP_KEYS), and the same inside a sentence (PrepareErrors.stepInSentence: "Stopped at checking the dump: …") -->
    <string name="prepare_step_identify">Checking the dump</string>
    <string name="prepare_step_rewrite">Rewriting the game code</string>
    <string name="prepare_step_split">Finding the shaders</string>
    <string name="prepare_step_shaders">Translating shaders</string>
    <string name="prepare_step_pack">Finishing the pack</string>
    <string name="prepare_step_identify_in_sentence">checking the dump</string>
    <string name="prepare_step_rewrite_in_sentence">rewriting the game code</string>
    <string name="prepare_step_split_in_sentence">finding the shaders</string>
    <string name="prepare_step_shaders_in_sentence">translating shaders</string>
    <string name="prepare_step_pack_in_sentence">finishing the pack</string>
    <!-- Job.stepMsg: the shaders step's end, and a step with its count; %1$s: a step above -->
