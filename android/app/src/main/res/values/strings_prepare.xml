    <string name="prepare_stage_check">Checking the shader library</string>
    <string name="prepare_step_shaders_progress">Translating shaders: %1$,d of %2$,d</string>
    <string name="prepare_step_progress">%1$s %2$,d / %3$,d</string>
    <string name="prepare_step_count">%1$s %2$,d</string>
    <!-- Job.statusMsg: the job's status line; %1$s: a step (prepare_step_*), %2$s in failed: why it failed (a prepare_error_* phrase, in the user's language
         when job.json has its code, else job.json's English error); Tap %3$s: the button's label -->
    <string name="prepare_status_done">Ready to play.</string>
    <string name="prepare_status_failed">Stopped at %1$s: %2$s. Tap %3$s to go on.</string>
    <string name="prepare_status_pending">Not started yet.</string>
    <string name="prepare_status_paused">Paused: %1$s. %2$s.</string>
    <string name="prepare_status_running">%1$s (step %2$d of %3$d).</string>
    <string name="prepare_status_interrupted">Interrupted at %1$s. Tap %2$s to go on.</string>
    <!-- a state or reason this app version does not know, as job.json has it -->
    <string name="prepare_status_raw">%1$s</string>
    <!-- Job.reasonMsg: why a job is paused; tap %1$s: the button's label -->
    <string name="prepare_reason_user">by you</string>
    <string name="prepare_reason_battery">battery below 20 %: plug in the charger to go on</string>
    <string name="prepare_reason_thermal">the phone is too hot: it goes on when it has cooled</string>
    <string name="prepare_reason_timeout">Android\'s daily limit for background work: open the app and tap %1$s</string>
    <string name="prepare_reason_refused">Android did not let it start in the background: open the app and tap %1$s</string>
    <string name="prepare_reason_apk">the app was updated with other shader tools: the shaders are translated again</string>
    <string name="prepare_reason_none">stopped</string>
    <string name="prepare_cannot_make_folder">cannot make %1$s</string>

